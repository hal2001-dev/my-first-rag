# =============================================================================
# RAG 시스템 환경 변수 설정 예시
# =============================================================================
# 이 파일을 복사하여 .env 파일을 만들고, 실제 값을 입력하세요.
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API 설정
# -----------------------------------------------------------------------------
# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=sk-your-api-key-here

# 사용할 GPT 모델 (gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo 등)
OPENAI_MODEL=gpt-4-turbo-preview

# 임베딩 모델 (text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# LLM 제공자 설정 (모델 교체를 위한 설정)
# -----------------------------------------------------------------------------
# 사용할 LLM 제공자 (openai, ollama, anthropic)
# 이 설정을 변경하면 다른 LLM 제공자를 사용할 수 있습니다.
LLM_PROVIDER=openai

# 사용할 임베딩 제공자 (openai, ollama, huggingface)
EMBEDDING_PROVIDER=openai

# -----------------------------------------------------------------------------
# Ollama 설정 (로컬 LLM 사용 시)
# -----------------------------------------------------------------------------
# Ollama 서버 URL (기본값: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama 모델 이름 (llama3, mistral, codellama 등)
OLLAMA_MODEL=llama3

# Ollama 임베딩 모델
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Anthropic API 설정 (Claude 사용 시)
# -----------------------------------------------------------------------------
# Anthropic API 키
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Claude 모델 (claude-3-opus-20240229, claude-3-sonnet-20240229 등)
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# -----------------------------------------------------------------------------
# ChromaDB 설정
# -----------------------------------------------------------------------------
# ChromaDB 데이터 저장 경로
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# ChromaDB 컬렉션 이름 (문서 그룹 식별자)
CHROMA_COLLECTION_NAME=rag_documents

# -----------------------------------------------------------------------------
# 문서 청킹 설정
# -----------------------------------------------------------------------------
# 청크 크기 (문자 수, 권장: 256-1024)
CHUNK_SIZE=512

# 청크 간 오버랩 (문자 수, 청크 크기의 10-20% 권장)
CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# 검색 설정
# -----------------------------------------------------------------------------
# 검색 시 반환할 문서 수 (Top-K)
RETRIEVAL_TOP_K=4

# -----------------------------------------------------------------------------
# 앱 설정
# -----------------------------------------------------------------------------
# 업로드 파일 저장 경로
UPLOAD_DIRECTORY=./data/uploads

# 최대 업로드 파일 크기 (MB)
MAX_UPLOAD_SIZE_MB=50

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
